# Local development environment for the Express API.
# Copy this file to .env and replace placeholder values.
# Never commit real .env files or secrets.

# Supabase/PostgreSQL configuration.
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=ptcf_reservation_dev
DB_USERNAME=postgres
DB_PASSWORD=your-local-db-password
DB_DIALECT=postgres

# JWT auth settings.
JWT_SECRET=replace-with-a-local-development-secret
JWT_EXPIRES_IN=1d
SALT_ROUNDS=12

# Supabase Auth.
AUTH_PROVIDER=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password
SUPABASE_AUTH_REDIRECT_URL=http://localhost:5173

# Cloudinary configuration.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=ptcf/dev

# Resend configuration.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com
SEED_EXTRA_ADMIN_EMAIL=
SEED_EXTRA_ADMIN_PASSWORD=

# Frontend URL.
FRONTEND_URL=http://localhost:5173

# Server configuration.
PORT=4000
NODE_ENV=development
BOOKING_EXPIRY_CRON_MINUTES=5
BOOKING_WARNING_CRON_MINUTES=15

# Kafka configuration.
KAFKA_ENABLED=false
KAFKA_CLIENT_ID=ptcf-booking-system
KAFKA_BROKERS=localhost:9092
KAFKA_BOOKING_EVENTS_TOPIC=booking-events
KAFKA_NOTIFICATION_CONSUMER_GROUP=notification-consumer
KAFKA_AUDIT_CONSUMER_GROUP=audit-log-consumer
KAFKA_ANALYTICS_CONSUMER_GROUP=analytics-consumer
