# ==================================================
# Local Development Environment Template
# ==================================================
# Copy this file to:
#   server/.env
#
# Then replace every placeholder value with your own.
# Never commit your real .env file.
# ==================================================

########################################
# Server
########################################

NODE_ENV=development
PORT=4000

########################################
# Authentication
########################################

# Supported values:
#   jwt
#   supabase
AUTH_PROVIDER=supabase

# Generate a strong secret:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-local-development-secret
JWT_EXPIRES_IN=1d
SALT_ROUNDS=12

########################################
# Database
########################################

# PostgreSQL connection settings.
# These correspond to your local or Supabase development database.

DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=ptcf_reservation_dev
DB_USERNAME=postgres
DB_PASSWORD=your-local-db-password
DB_DIALECT=postgres

########################################
# Frontend
########################################

FRONTEND_URL=http://localhost:5173

########################################
# Cloudinary
########################################

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=ptcf/dev

########################################
# Supabase
########################################

SUPABASE_URL=https://your-project-ref.supabase.co

# Public key (safe to expose to frontend)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only key (keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

SUPABASE_AUTH_REDIRECT_URL=http://localhost:5173

SUPABASE_PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password

########################################
# Email (Resend)
########################################

RESEND_API_KEY=your-resend-api-key

RESEND_FROM_EMAIL=noreply@example.com

########################################
# Development Seed Data
########################################

# Optional administrator account automatically created
# during local development.

SEED_EXTRA_ADMIN_EMAIL=admin@example.com
SEED_EXTRA_ADMIN_PASSWORD=change-me

########################################
# Booking Jobs
########################################

BOOKING_EXPIRY_CRON_MINUTES=1
BOOKING_WARNING_CRON_MINUTES=1

########################################
# Kafka
########################################

KAFKA_ENABLED=false

KAFKA_CLIENT_ID=ptcf-booking-system

# Comma-separated if multiple brokers
KAFKA_BROKERS=localhost:9092

KAFKA_BOOKING_EVENTS_TOPIC=booking-events

KAFKA_NOTIFICATION_CONSUMER_GROUP=notification-consumer
KAFKA_AUDIT_CONSUMER_GROUP=audit-log-consumer
KAFKA_ANALYTICS_CONSUMER_GROUP=analytics-consumer