{
  "openapi": "3.0.3",
  "info": {
    "title": "PTCF Room & Equipment Reservation System API",
    "description": "API documentation for the UPLB ICropS Plant Tissue Culture Facility reservation management system.",
    "version": "1.0.0",
    "contact": {
      "name": "PTCF Development Team"
    }
  },
  "servers": [
    {
      "url": "http://localhost:4000/api",
      "description": "Local development server"
    },
    {
      "url": "https://your-render-url.onrender.com/api",
      "description": "Production server (Render)"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Server health and status endpoints"
    },
    {
      "name": "Authentication",
      "description": "User registration, login, and authentication endpoints"
    },
    {
      "name": "User",
      "description": "User profile and role-based access endpoints"
    },
    {
      "name": "Equipment",
      "description": "Equipment CRUD operations with optional image uploads"
    },
    {
      "name": "Rooms",
      "description": "Room CRUD operations with optional image uploads"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Check server health",
        "description": "Returns the current status of the server and confirms it's running.",
        "operationId": "checkHealth",
        "responses": {
          "200": {
            "description": "Server is healthy and running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "message": {
                      "type": "string",
                      "example": "PTCF server is running"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register a new user",
        "description": "Creates a new user account. Email must be unique. Password is hashed using bcrypt. No JWT token is returned (login-only JWT pattern).",
        "operationId": "registerUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              },
              "examples": {
                "regularUser": {
                  "summary": "Regular user registration",
                  "value": {
                    "email": "student@uplb.edu.ph",
                    "password": "password123",
                    "accountType": "regular_user",
                    "userCategory": "student"
                  }
                },
                "staffUser": {
                  "summary": "PTCF staff registration",
                  "value": {
                    "email": "staff@uplb.edu.ph",
                    "password": "staff123",
                    "accountType": "ptcf_staff",
                    "userCategory": "lab_technician"
                  }
                },
                "adminUser": {
                  "summary": "System admin registration",
                  "value": {
                    "email": "admin@uplb.edu.ph",
                    "password": "admin123",
                    "accountType": "system_admin"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User successfully registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - Missing required fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missingEmail": {
                    "value": {
                      "message": "email is required"
                    }
                  },
                  "missingPassword": {
                    "value": {
                      "message": "password is required"
                    }
                  },
                  "missingAccountType": {
                    "value": {
                      "message": "accountType is required"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Conflict - Email already in use",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Email already in use"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "User login",
        "description": "Authenticates a user and returns a JWT token for subsequent authenticated requests.",
        "operationId": "loginUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "examples": {
                "regularUser": {
                  "summary": "Student login",
                  "value": {
                    "email": "student@uplb.edu.ph",
                    "password": "password123"
                  }
                },
                "staffUser": {
                  "summary": "Staff login",
                  "value": {
                    "email": "staff@uplb.edu.ph",
                    "password": "staff123"
                  }
                },
                "adminUser": {
                  "summary": "Admin login",
                  "value": {
                    "email": "admin@uplb.edu.ph",
                    "password": "admin123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful - JWT token returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - Missing email or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "email and password are required"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Invalid credentials"
                }
              }
            }
          },
          "500": {
            "description": "Server error - JWT_SECRET not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "JWT_SECRET not configured"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["User"],
        "summary": "Get current user info",
        "description": "Returns the authenticated user's profile information. Requires a valid JWT token.",
        "operationId": "getCurrentUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user information retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/UserProfile"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missingToken": {
                    "value": {
                      "message": "Missing Bearer token"
                    }
                  },
                  "invalidToken": {
                    "value": {
                      "message": "Invalid or expired token"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/staff-only": {
      "get": {
        "tags": ["User"],
        "summary": "Staff-only endpoint (Test)",
        "description": "Test endpoint accessible only to PTCF staff and system administrators. Used for role-based access control verification.",
        "operationId": "staffOnlyTest",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Staff access granted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Staff access granted"
                    },
                    "user": {
                      "$ref": "#/components/schemas/UserProfile"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Insufficient role (requires staff or admin)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Forbidden: insufficient role"
                }
              }
            }
          }
        }
      }
    },
    "/auth/admin-only": {
      "get": {
        "tags": ["User"],
        "summary": "Admin-only endpoint (Test)",
        "description": "Test endpoint accessible only to system administrators. Used for role-based access control verification.",
        "operationId": "adminOnlyTest",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Admin access granted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Admin access granted"
                    },
                    "user": {
                      "$ref": "#/components/schemas/UserProfile"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Insufficient role (requires admin)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Forbidden: insufficient role"
                }
              }
            }
          }
        }
      }
    },
    "/equipment": {
      "get": {
        "tags": ["Equipment"],
        "summary": "Get all equipment",
        "description": "Returns a list of all equipment items. Accessible to all authenticated users.",
        "operationId": "getAllEquipment",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of equipment retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Equipment"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      },
      "post": {
        "tags": ["Equipment"],
        "summary": "Create new equipment",
        "description": "Creates a new equipment item with optional image upload. Requires staff or admin role.",
        "operationId": "createEquipment",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["name", "category", "description"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Equipment name",
                    "example": "Laminar Flow Hood"
                  },
                  "category": {
                    "type": "string",
                    "description": "Equipment category",
                    "example": "Sterilization Equipment"
                  },
                  "description": {
                    "type": "string",
                    "description": "Detailed description",
                    "example": "Class II Biological Safety Cabinet"
                  },
                  "status": {
                    "type": "string",
                    "enum": ["available", "unavailable", "maintenance"],
                    "description": "Availability status (optional, defaults to 'available')",
                    "example": "available"
                  },
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "Image file (optional, max 5MB, JPEG/PNG/GIF/WebP)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Equipment created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Equipment"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - Missing required fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Missing required fields: name, category, and description are required"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "500": {
            "description": "Server error - Failed to upload image or create equipment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/equipment/{id}": {
      "get": {
        "tags": ["Equipment"],
        "summary": "Get equipment by ID",
        "description": "Returns a single equipment item by ID. Accessible to all authenticated users.",
        "operationId": "getEquipmentById",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Equipment ID",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Equipment retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Equipment"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "description": "Equipment not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Equipment not found"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Equipment"],
        "summary": "Update equipment",
        "description": "Updates an existing equipment item. Can optionally update the image. Requires staff or admin role.",
        "operationId": "updateEquipment",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Equipment ID",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Equipment name (optional)"
                  },
                  "category": {
                    "type": "string",
                    "description": "Equipment category (optional)"
                  },
                  "description": {
                    "type": "string",
                    "description": "Detailed description (optional)"
                  },
                  "status": {
                    "type": "string",
                    "enum": ["available", "unavailable", "maintenance"],
                    "description": "Availability status (optional)"
                  },
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "New image file (optional, replaces existing image)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Equipment updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Equipment"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "description": "Equipment not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Equipment"],
        "summary": "Delete equipment",
        "description": "Deletes an equipment item by ID. Requires staff or admin role.",
        "operationId": "deleteEquipment",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Equipment ID",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Equipment deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Equipment deleted successfully"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "description": "Equipment not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
