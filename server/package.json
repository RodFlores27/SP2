{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:contention": "node tests/contention.service.test.js",
    "start": "node index.js",
    "dev": "nodemon index.js",
    "kafka:check": "node scripts/check-kafka.js",
    "clear:bookings": "node scripts/clear-bookings.js",
    "clear:supabase-auth": "node scripts/clear-supabase-auth-users.js",
    "reset:mvp-demo": "node scripts/reset-mvp-demo-data.js",
    "sync:supabase-auth": "node scripts/sync-supabase-auth-users.js",
    "seed:all:local": "sequelize-cli db:seed:all --env development",
    "migrate:status:local": "sequelize-cli db:migrate:status --env development",
    "migrate:local": "sequelize-cli db:migrate --env development",
    "migrate:prod": "sequelize-cli db:migrate --env production",
    "seed:foundation:local": "node scripts/seed-foundation-only.js",
    "seed:foundation:replace:local": "node scripts/seed-foundation-only.js --replace-resources",
    "seed:showcase:calendar:local": "sequelize-cli db:seed --seed 20260425130000-seed-calendar-showcase-day.js --env development",
    "seed:showcase:mybookings:admin:local": "sequelize-cli db:seed --seed 20260510130000-seed-my-bookings-showcase-admin.js --env development",
    "seed:showcase:all:local": "npm run seed:showcase:calendar:local && npm run seed:showcase:mybookings:admin:local",
    "seed:showcase:undo:calendar:local": "sequelize-cli db:seed:undo --seed 20260425130000-seed-calendar-showcase-day.js --env development",
    "seed:showcase:undo:mybookings:admin:local": "sequelize-cli db:seed:undo --seed 20260510130000-seed-my-bookings-showcase-admin.js --env development",
    "seed:showcase:undo:all:local": "npm run seed:showcase:undo:mybookings:admin:local && npm run seed:showcase:undo:calendar:local",
    "seed:showcase:fresh:local": "npm run clear:bookings && npm run seed:showcase:all:local",
    "seed:calendar:demo:local": "npm run seed:showcase:fresh:local",
    "seed:showcase:calendar:prod": "sequelize-cli db:seed --seed 20260425130000-seed-calendar-showcase-day.js --env production",
    "seed:showcase:mybookings:admin:prod": "sequelize-cli db:seed --seed 20260510130000-seed-my-bookings-showcase-admin.js --env production",
    "seed:showcase:all:prod": "npm run seed:showcase:calendar:prod && npm run seed:showcase:mybookings:admin:prod",
    "seed:showcase:undo:calendar:prod": "sequelize-cli db:seed:undo --seed 20260425130000-seed-calendar-showcase-day.js --env production",
    "seed:showcase:undo:mybookings:admin:prod": "sequelize-cli db:seed:undo --seed 20260510130000-seed-my-bookings-showcase-admin.js --env production",
    "seed:showcase:undo:all:prod": "npm run seed:showcase:undo:mybookings:admin:prod && npm run seed:showcase:undo:calendar:prod",
    "seed:uat:accounts": "node scripts/seed-uat-accounts.js",
    "seed:uat:contention": "node scripts/seed-uat-contention.js",
    "seed:uat:refresh": "node scripts/seed-uat-contention.js --mode refresh && node scripts/seed-uat-admin-showcase.js",
    "seed:uat:admin-showcase": "node scripts/seed-uat-admin-showcase.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "axios": "^1.14.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "resend": "^6.10.0",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}
