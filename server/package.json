  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:contention": "node tests/contention.service.test.js",
    "start": "node index.js",
    "dev": "nodemon index.js",
    "kafka:check": "node scripts/check-kafka.js",
    "clear:bookings": "node scripts/clear-bookings.js",
    "clear:supabase-auth": "node scripts/clear-supabase-auth-users.js",
    "reset:mvp-demo": "node scripts/reset-mvp-demo-data.js",
    "sync:supabase-auth": "node scripts/sync-supabase-auth-users.js",
    "seed:all": "sequelize-cli db:seed:all",
    "migrate:status": "sequelize-cli db:migrate:status",
    "migrate": "sequelize-cli db:migrate",
    "seed:foundation": "node scripts/seed-foundation-only.js",
    "seed:foundation:replace": "node scripts/seed-foundation-only.js --replace-resources",
    "seed:showcase:calendar": "sequelize-cli db:seed --seed 20260425130000-seed-calendar-showcase-day.js",
    "seed:showcase:mybookings:admin": "sequelize-cli db:seed --seed 20260510130000-seed-my-bookings-showcase-admin.js",
    "seed:showcase:all": "npm run seed:showcase:calendar && npm run seed:showcase:mybookings:admin",
    "seed:showcase:undo:calendar": "sequelize-cli db:seed:undo --seed 20260425130000-seed-calendar-showcase-day.js",
    "seed:showcase:undo:mybookings:admin": "sequelize-cli db:seed:undo --seed 20260510130000-seed-my-bookings-showcase-admin.js",
    "seed:showcase:undo:all": "npm run seed:showcase:undo:mybookings:admin && npm run seed:showcase:undo:calendar",
    "seed:showcase:fresh": "npm run clear:bookings && npm run seed:showcase:all",
    "seed:calendar:demo": "npm run seed:showcase:fresh",
    "seed:uat:accounts": "node scripts/seed-uat-accounts.js",
    "seed:uat:contention": "node scripts/seed-uat-contention.js",
    "seed:uat:refresh": "node scripts/seed-uat-contention.js --mode refresh && node scripts/seed-uat-admin-showcase.js",
    "seed:uat:admin-showcase": "node scripts/seed-uat-admin-showcase.js"
  },
