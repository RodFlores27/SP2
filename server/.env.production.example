# ==================================================
# Production Environment Template
# ==================================================
# Copy this file to:
#   server/.env.production
#
# Then replace every placeholder value with your own.
# Never commit your real .env.production file.
# ==================================================

########################################
# Server
########################################

NODE_ENV=production
PORT=4000

########################################
# Authentication
########################################

# Supported values:
#   jwt
#   supabase
AUTH_PROVIDER=supabase

# Generate a strong secret:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=1d
SALT_ROUNDS=12

########################################
# Database
########################################

# PostgreSQL connection string
#
# Format:
# postgresql://<username>:<password>@<host>:<port>/<database>
#
# Example:
# postgresql://postgres:myPassword@db.example.com:6543/postgres
DATABASE_URL=postgresql://username:password@host:6543/database

########################################
# Frontend
########################################

CLIENT_URL=https://your-frontend-domain.com
FRONTEND_URL=https://your-frontend-domain.com

########################################
# Cloudinary
########################################

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=ptcf/prod

########################################
# Supabase
########################################

SUPABASE_URL=https://your-project.supabase.co

# Public key (safe to expose to frontend)
SUPABASE_ANON_KEY=your-anon-key

# Server-only key (keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

SUPABASE_AUTH_REDIRECT_URL=https://your-frontend-domain.com
SUPABASE_PASSWORD_RESET_REDIRECT_URL=https://your-frontend-domain.com/reset-password

########################################
# Email (Resend)
########################################

RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

########################################
# Booking Jobs
########################################

BOOKING_EXPIRY_CRON_MINUTES=5
BOOKING_WARNING_CRON_MINUTES=15

########################################
# Kafka
########################################

KAFKA_ENABLED=true

KAFKA_CLIENT_ID=ptcf-booking-system

# Comma-separated if multiple brokers
KAFKA_BROKERS=your-kafka-host:9092

KAFKA_USERNAME=your-username
KAFKA_PASSWORD=your-password

KAFKA_SSL=true
KAFKA_SASL_MECHANISM=SCRAM-SHA-256

# Paste the COMPLETE CA certificate exactly as provided
# by your Kafka provider, including both BEGIN/END lines.
#
# Example:
#
# KAFKA_CA_CERT="-----BEGIN CERTIFICATE-----
# MIIF...
# ...
# -----END CERTIFICATE-----"
#
# Keep the surrounding double quotes.
KAFKA_CA_CERT=""

KAFKA_AUTO_CREATE_TOPICS=false

KAFKA_BOOKING_EVENTS_TOPIC=booking-events

KAFKA_NOTIFICATION_CONSUMER_GROUP=notification-consumer
KAFKA_AUDIT_CONSUMER_GROUP=audit-log-consumer
KAFKA_ANALYTICS_CONSUMER_GROUP=analytics-consumer

########################################
# Misc
########################################

UAT_AUTH_DOC_URL=https://your-public-example-document.pdf