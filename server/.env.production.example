# Production environment template for DigitalOcean Droplet deployment.
# Copy values from this template into server/.env.production on your Droplet and fill in real values.
# Never commit real .env.production files or secrets.

########################################
# Database
########################################
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=ptcf_reservation_prod
DB_USERNAME=postgres
DB_PASSWORD=your-production-db-password
DB_DIALECT=postgres
DB_SSL=false

########################################
# Server
########################################
NODE_ENV=production
PORT=4000

########################################
# Authentication
########################################
AUTH_PROVIDER=jwt

# Generate a strong 64-character hex secret for production, e.g. using:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-strong-production-secret
JWT_EXPIRES_IN=1d
SALT_ROUNDS=12

########################################
# Frontend Links
########################################
# Used for CORS, cookies, and email links.
CLIENT_URL=https://your-frontend-domain.com
FRONTEND_URL=https://your-frontend-domain.com

########################################
# Cloudinary
########################################
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=ptcf/production

########################################
# Email (Resend)
########################################
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@mail.yourdomain.dev

########################################
# Booking Jobs
########################################
BOOKING_EXPIRY_CRON_MINUTES=5
BOOKING_WARNING_CRON_MINUTES=15

########################################
# Kafka (Disabled for standalone Droplet setup)
########################################
KAFKA_ENABLED=false
KAFKA_CLIENT_ID=ptcf-booking-system
KAFKA_BOOKING_EVENTS_TOPIC=booking-events
KAFKA_NOTIFICATION_CONSUMER_GROUP=notification-consumer
KAFKA_AUDIT_CONSUMER_GROUP=audit-log-consumer
KAFKA_ANALYTICS_CONSUMER_GROUP=analytics-consumer

########################################
# UAT / Seed Helpers
########################################
UAT_AUTH_DOC_URL=https://res.cloudinary.com/demo/sample.pdf
